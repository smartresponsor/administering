{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}{{ page_title }}{% endblock %}

{% block main %}
    <section class="content-header">
        <h1 class="title mb-1">{{ page_title }}</h1>
        {% if lead is not empty %}
            <p class="text-muted mb-0">{{ lead }}</p>
        {% endif %}
    </section>

    <section class="content-body mt-4">
        {% if error_message is not empty %}
            <div class="alert alert-danger">
                {{ error_message }}
            </div>
        {% endif %}

        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="row g-3">
                {{ form_widget(form) }}
            </div>
        {{ form_end(form) }}

        {% if result_html is not empty %}
            <h2 class="mt-4">{{ result_title }}</h2>
            <div class="mt-3">
                {{ result_html|raw }}
            </div>
        {% elseif result_json is not empty %}
            <h2 class="mt-4">{{ result_title }}</h2>
            <pre class="bg-light border rounded p-3 small">{{ result_json }}</pre>
        {% endif %}

        {% if action_links is not empty %}
            <div class="d-flex flex-wrap gap-2 mt-3">
                {% for link in action_links %}
                    <a class="btn btn-outline-primary" href="{{ link.url }}">{{ link.label }}</a>
                {% endfor %}
            </div>
        {% endif %}

        {% if back_url is not empty %}
            <p class="mt-4"><a href="{{ back_url }}">Back</a></p>
        {% endif %}
    </section>
{% endblock %}
