{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Accessing Account Actions{% endblock %}

{% block main %}
    <section class="content-panel">
        <p class="text-muted">
            Controlled action requests only. Accessing remains the owner of login, session, password, 2FA, and security internals.
        </p>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{
                    message
                }}</div>
            {% endfor %}
        {% endfor %}

        <table class="table datagrid">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Label</th>
                    <th>Risk</th>
                    <th>Reason required</th>
                    <th>Submit controlled request</th>
                </tr>
            </thead>
            <tbody>
            {% for row in action_rows %}
                <tr>
                    <td><code>{{ row.descriptor.key }}</code></td>
                    <td>{{ row.descriptor.label }}</td>
                    <td>{{ row.descriptor.riskLevel }}</td>
                    <td>{{ row.descriptor.requiresReason ? 'yes' : 'no' }}</td>
                    <td>
                        {{ form_start(row.form, { action: path('administration_accessing_account_action_execute') }) }}
                            {{ form_widget(row.form.action) }}
                            <div class="mb-2">
                                {{ form_label(row.form.accountReference) }}
                                {{ form_widget(row.form.accountReference) }}
                                {{ form_errors(row.form.accountReference) }}
                            </div>
                            <div class="mb-2">
                                {{ form_label(row.form.reason) }}
                                {{ form_widget(row.form.reason) }}
                                {{ form_help(row.form.reason) }}
                                {{ form_errors(row.form.reason) }}
                            </div>
                            {{ form_widget(row.form.submit) }}
                        {{ form_end(row.form) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No controlled Accessing account actions are registered.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
