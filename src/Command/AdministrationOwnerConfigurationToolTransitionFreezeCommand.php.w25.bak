<?php

declare(strict_types=1);

namespace App\Administering\Command;

use App\Administering\Value\Admin\AdministrationOwnerConfigurationToolTransitionFreezeReport;
use Symfony\Component\Console\Attribute\AsCommand;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Style\SymfonyStyle;

#[AsCommand(
    name: 'administering:owner-configuration-tools:transition-freeze',
    description: 'Builds the final freeze report for pausing internal Administering transition waves and switching to owner/host current-slice work.',
)]
final class AdministrationOwnerConfigurationToolTransitionFreezeCommand extends Command
{
    public function __construct(private readonly string $projectDir)
    {
        parent::__construct();
    }

    protected function configure(): void
    {
        $this
            ->addOption('json', null, InputOption::VALUE_NONE, 'Print freeze report as JSON.')
            ->addOption('write-json', null, InputOption::VALUE_REQUIRED, 'Write freeze report JSON to this path.')
            ->addOption('fail-if-not-frozen', null, InputOption::VALUE_NONE, 'Fail when the internal transition track is not ready to freeze.')
            ->addOption('pipeline-report', null, InputOption::VALUE_REQUIRED, 'External package pipeline report path.', 'delivery/patches/administering_owner_configuration_tool_external_package_pipeline.json')
            ->addOption('handoff-dir', null, InputOption::VALUE_REQUIRED, 'External handoff bundle directory.', 'delivery/owner-side-external-handoff')
            ->addOption('handoff-validation', null, InputOption::VALUE_REQUIRED, 'External handoff bundle validation report path.', 'delivery/patches/administering_owner_configuration_tool_external_handoff_bundle_validation.json')
            ->addOption('transition-status', null, InputOption::VALUE_REQUIRED, 'Transition status report path.', 'delivery/patches/administering_owner_configuration_tool_transition_status.json')
            ->addOption('transition-decision', null, InputOption::VALUE_REQUIRED, 'Transition decision report path.', 'delivery/patches/administering_owner_configuration_tool_transition_decision.json')
            ->addOption('pause-gate', null, InputOption::VALUE_REQUIRED, 'Transition pause gate report path.', 'delivery/patches/administering_owner_configuration_tool_transition_pause_gate.json')
            ->addOption('handoff-checklist', null, InputOption::VALUE_REQUIRED, 'Transition handoff checklist report path.', 'delivery/patches/administering_owner_configuration_tool_transition_handoff_checklist.json')
            ->addOption('host-slice-ready', null, InputOption::VALUE_NONE, 'Mark host/post-application current slice as available for the next work mode.');
    }

    protected function execute(InputInterface $input, OutputInterface $output): int
    {
        $io = new SymfonyStyle($input, $output);

        $artifacts = [
            $this->jsonArtifact('pipeline_report', 'External package pipeline report', (string) $input->getOption('pipeline-report'), 'Run external-package-pipeline.'),
            $this->directoryArtifact('handoff_bundle', 'External handoff bundle directory', (string) $input->getOption('handoff-dir'), 'Run external-package-handoff-bundle.'),
            $this->jsonArtifact('handoff_validation', 'External handoff bundle validation report', (string) $input->getOption('handoff-validation'), 'Run external-package-handoff-bundle:validate.'),
            $this->jsonArtifact('transition_status', 'Transition status report', (string) $input->getOption('transition-status'), 'Run transition-status.'),
            $this->jsonArtifact('transition_decision', 'Transition decision report', (string) $input->getOption('transition-decision'), 'Run transition-decision.'),
            $this->jsonArtifact('transition_pause_gate', 'Transition pause gate report', (string) $input->getOption('pause-gate'), 'Run transition-pause-gate.'),
            $this->jsonArtifact('transition_handoff_checklist', 'Transition handoff checklist report', (string) $input->getOption('handoff-checklist'), 'Run transition-handoff-checklist.'),
        ];

        $missingArtifacts = count(array_filter($artifacts, static fn (array $item): bool => 'missing' === $item['status']));
        $hostSliceReady = (bool) $input->getOption('host-slice-ready');
        $internalWavesFrozen = 0 === $missingArtifacts;

        $freezeReasons = $internalWavesFrozen
            ? [
                'Administering has a materialized SQLite projection model for service tools.',
                'Owner-side discovery, validation, materialization preview, and guarded open/execute flow are present.',
                'External package manifest, validation, overlay plan, apply script, handoff bundle, and handoff validation pipeline are available.',
                'Further ecosystem configuration semantics should move to owner repositories rather than expanding Administering-owned tools.',
            ]
            : [
                'Required transition artifacts are missing; the internal Administering transition track should not be frozen yet.',
            ];

        $remainingActions = $internalWavesFrozen
            ? [
                'Stop adding new ecosystem-owned configuration tools directly to Administering.',
                'Request current slices for owner repositories that should receive owner-side configuration tools.',
                'Apply generated external neighbor packages only as reviewed overlay patches against those current slices.',
                'Keep Symfony environment, credentials, secrets, deployment profile, and framework-level configuration in a separate host/post-application track.',
            ]
            : [
                'Generate the missing transition artifacts listed in this report.',
                'Re-run transition-freeze before switching to owner repository current-slice work.',
            ];

        $nextWorkMode = $internalWavesFrozen
            ? ($hostSliceReady ? 'request_owner_and_host_current_slices' : 'request_owner_repository_current_slices_first')
            : 'finish_administering_transition_artifacts';

        $report = new AdministrationOwnerConfigurationToolTransitionFreezeReport(
            $artifacts,
            $freezeReasons,
            $remainingActions,
            $internalWavesFrozen,
            $nextWorkMode,
        );

        $writeJson = $this->normalizeOptionalString($input->getOption('write-json'));
        if (null !== $writeJson) {
            $targetPath = $this->projectPath($writeJson);
            $targetDirectory = dirname($targetPath);
            if (!is_dir($targetDirectory) && !mkdir($targetDirectory, 0775, true) && !is_dir($targetDirectory)) {
                $io->error(sprintf('Unable to create freeze report directory: %s', $targetDirectory));

                return Command::FAILURE;
            }

            file_put_contents($targetPath, json_encode($report->toArray(), JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
            $io->success(sprintf('Owner-side transition freeze report written to %s.', $targetPath));
        }

        $shouldFail = (bool) $input->getOption('fail-if-not-frozen') && !$report->internalWavesFrozen;
        if ((bool) $input->getOption('json')) {
            $output->writeln(json_encode($report->toArray(), JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));

            return $shouldFail ? Command::FAILURE : Command::SUCCESS;
        }

        $io->section('Owner-side transition freeze');
        $io->writeln(sprintf('Internal waves frozen: <info>%s</info>', $report->internalWavesFrozen ? 'yes' : 'not yet'));
        $io->writeln(sprintf('Next work mode: <info>%s</info>', $report->nextWorkMode));
        $io->writeln(sprintf('Ready artifacts: <info>%d</info>', $report->readyArtifactCount()));
        $io->writeln(sprintf('Missing artifacts: <comment>%d</comment>', $report->missingArtifactCount()));

        $io->table(
            ['Key', 'Title', 'Status', 'Path', 'Note'],
            array_map(static fn (array $item): array => [
                $item['key'],
                $item['title'],
                $item['status'],
                $item['path'] ?? '-',
                $item['note'],
            ], $artifacts),
        );

        $io->section('Freeze reasons');
        foreach ($report->freezeReasons as $reason) {
            $io->writeln('- '.$reason);
        }

        $io->section('Remaining actions');
        foreach ($report->remainingActions as $action) {
            $io->writeln('- '.$action);
        }

        return $shouldFail ? Command::FAILURE : Command::SUCCESS;
    }

    /** @return array{key:string, title:string, status:string, path:?string, note:string} */
    private function jsonArtifact(string $key, string $title, string $path, string $missingNote): array
    {
        $absolutePath = $this->projectPath($path);
        if (!is_file($absolutePath)) {
            return [
                'key' => $key,
                'title' => $title,
                'status' => 'missing',
                'path' => $path,
                'note' => $missingNote,
            ];
        }

        try {
            $contents = file_get_contents($absolutePath);
            json_decode(false === $contents ? '' : $contents, true, 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException) {
            return [
                'key' => $key,
                'title' => $title,
                'status' => 'warning',
                'path' => $path,
                'note' => 'Artifact exists, but JSON could not be parsed.',
            ];
        }

        return [
            'key' => $key,
            'title' => $title,
            'status' => 'ready',
            'path' => $path,
            'note' => 'Artifact exists and JSON is parseable.',
        ];
    }

    /** @return array{key:string, title:string, status:string, path:?string, note:string} */
    private function directoryArtifact(string $key, string $title, string $path, string $missingNote): array
    {
        $absolutePath = $this->projectPath($path);
        $ready = is_dir($absolutePath)
            && is_file($absolutePath.'/README.adoc')
            && is_file($absolutePath.'/CHECKLIST.adoc')
            && is_file($absolutePath.'/handoff-report.json');

        return [
            'key' => $key,
            'title' => $title,
            'status' => $ready ? 'ready' : 'missing',
            'path' => $path,
            'note' => $ready ? 'Bundle directory has required files.' : $missingNote,
        ];
    }

    private function projectPath(string $path): string
    {
        if ('' === $path) {
            return $this->projectDir;
        }

        if (str_starts_with($path, '/') || preg_match('/^[A-Za-z]:[\\\\\/]/', $path)) {
            return $path;
        }

        return rtrim($this->projectDir, '/\\').'/'.ltrim($path, '/\\');
    }

    private function normalizeOptionalString(mixed $value): ?string
    {
        if (!is_string($value)) {
            return null;
        }

        $trimmed = trim($value);

        return '' === $trimmed ? null : $trimmed;
    }
}
