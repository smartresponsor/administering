{
  "name": "administering/administration",
  "description": "Administering administrative governance component for Symfony host applications.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/cruding.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/collectioning.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/tabling.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/viewing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/interfacing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/objecting.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/gating.git",
      "no-api": true
    }
  ],
  "require": {
    "cruding/crud": "dev-master",
    "collectioning/collection": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.0",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "php": "^8.4",
    "symfony/asset-mapper": "^8.1",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/filesystem": "^8.1",
    "symfony/finder": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/lock": "^8.1",
    "symfony/messenger": "^8.1",
    "symfony/process": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/scheduler": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/security-csrf": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/stimulus-bundle": "^2.35",
    "symfony/twig-bundle": "^8.1",
    "symfony/ux-turbo": "^3.0",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "twig/twig": "^3.15"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.47",
    "friendsofphp/php-cs-fixer": "^3.94",
    "icanhazstring/composer-unused": "^0.9.6",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.0",
    "symfony/maker-bundle": "^1.64",
    "symfony/phpunit-bridge": "^8.1",
    "gating/gate": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Administering\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Administering\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "symfony/runtime": true
    },
    "process-timeout": 0,
    "sort-packages": true
  },
  "extra": {
    "public-dir": "public",
    "product-name": "Administering",
    "core-entity": "Administration"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "configuring/config": "Optional runtime-scope evidence package. Administering discovers it through composer inventory and runtime-scope locks; it must not be required for standalone installation."
  }
}
